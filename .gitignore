# =========================
# Dependencies
# =========================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# =========================
# Next.js / build
# =========================
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# =========================
# Env & secrets (NEVER commit — live .env safe on git pull)
# =========================
.env
.env.*
!.env.example
!.env.docker.example
*.pem
*.p12
*.key

# Firebase service account JSON
*firebase-adminsdk*.json
**/firebase-service-account.json
service-account*.json

# =========================
# Runtime uploads (live volume / disk — don't overwrite on pull)
# =========================
public/uploads/**
!public/uploads/.gitkeep
!public/uploads/**/.gitkeep

# =========================
# DB dumps / backups
# =========================
*.sql
*.dump
*.backup
scavenger_hunt*.sql
scavenger_hunt*.dump

# Prisma migrations are source code, not dumps
!prisma/migrations/**/*.sql

# =========================
# Logs & debug
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =========================
# OS / editor junk
# =========================
.DS_Store
**/.DS_Store
**/._*
._*
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# =========================
# Cursor / local tooling
# =========================
.cursor/
.cursor-tmp/
terminals/
coverage/
.turbo/
.vercel/

# =========================
# Docker local overrides (optional)
# =========================
docker-compose.override.yml
.env.docker
